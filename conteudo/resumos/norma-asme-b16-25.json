{
 "id": "ASME-B16.25",
 "titulo": "ASME B16.25 — Extremidades para solda de topo (chanfros)",
 "secoes": [
  {
   "titulo": "Escopo e unidades",
   "item": "1",
   "texto": "Define a preparação das pontas de componentes de tubulação para solda de topo: chanfros, perfil externo e interno de peças de parede grossa e preparação interna para soldar sem anel, com anel partido ou contínuo, com inserto consumível ou com raiz em GTAW. Vale para qualquer metal com procedimento qualificável. Valores em SI e em polegadas são sistemas independentes: misturar os dois é não conformidade. Tabelas por NPS na ficha tubulacao-processo.",
   "valores": []
  },
  {
   "titulo": "Envelope de transição",
   "item": "2; Fig. 2-1",
   "texto": "Quando a peça é mais grossa que o tubo, o perfil perto da ponta deve ficar dentro de um envelope: inclinação limitada por fora e por dentro, raios mínimos e espessura máxima na extremidade. O reforço de solda permitido pelo código pode ultrapassar o envelope.",
   "valores": [
    {"parametro": "Espessura mínima na extremidade", "valor": "1,0 × tmin", "item": "Fig. 2-1", "cota": "esquemas/tubulacao-processo-b16-25-envelope-transicao.svg#tmin"},
    {"parametro": "Espessura máxima (pedido por parede mínima)", "valor": "maior entre tmin + 4 mm e 1,15·tmin", "item": "5.4", "cota": "esquemas/tubulacao-processo-b16-25-envelope-transicao.svg#tmax"},
    {"parametro": "Espessura máxima (pedido por parede nominal)", "valor": "maior entre tmin + 4 mm e 1,10 × parede nominal", "item": "5.4", "cota": "esquemas/tubulacao-processo-b16-25-envelope-transicao.svg#tmax"},
    {"parametro": "tmin de tubo com tolerância −12,5 %", "valor": "0,875 × parede nominal", "item": "Fig. 2-1, Nota (4)", "cota": "esquemas/tubulacao-processo-b16-25-envelope-transicao.svg#tmin"},
    {"parametro": "Inclinação externa", "valor": "≤ 30° numa faixa de 1,5·tmin; até 45° junto à superfície; raios ≥ 0,05·tmin", "item": "Fig. 2-1", "cota": "esquemas/tubulacao-processo-b16-25-envelope-transicao.svg#ext"},
    {"parametro": "Inclinação interna", "valor": "≤ 1:3 dentro de 2·tmin a partir da face de raiz", "item": "Fig. 2-1", "cota": "esquemas/tubulacao-processo-b16-25-envelope-transicao.svg#int"}
   ],
