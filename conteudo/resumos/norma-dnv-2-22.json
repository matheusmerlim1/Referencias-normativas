  {
   "titulo": "Fator dinâmico",
   "item": "Ch.2 Sec.2 1.3; Sec.6",
   "texto": "O fator dinâmico depende da rigidez no gancho, da carga e da velocidade relativa entre gancho e carga. Em guindastes offshore a velocidade relativa combina a velocidade de içamento com os movimentos do barco de apoio e da própria unidade, função da altura de onda; há mínimos de fator e de velocidade de içamento. Caçambas acrescem.",
   "valores": [
    {
     "parametro": "Fórmula geral",
     "valor": "ψ = 1 + VR·√(C/(W·g))",
     "item": "1.3"
    },
    {
     "parametro": "ψ mínimo offshore",
     "valor": "1,3 (10 kN < W ≤ 2 500 kN); 1,1 (W > 5 000 kN)",
     "item": "Ch.2 Sec.6"
    },
    {
     "parametro": "Velocidade relativa",
     "valor": "VR = 0,5 VL + √(Vin² + Vt²)",
     "item": "Sec.6 2.2.1"
    },
    {
     "parametro": "Velocidade mínima de içamento",
     "valor": "VH = 0,1 (Hs + 1) m/s",
     "item": "Sec.6 2.2.2"
    },
